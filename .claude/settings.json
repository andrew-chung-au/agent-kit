{
  "env": {
    "AGENT_KIT_CLOUD_PUSH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git push -u origin claude/*)"
    ],
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/agent-kit.conf)",
      "Edit(/_docs/specs.md)",
      "Edit(/agent-kit/**)",
      "Edit(/Makefile)",
      "Edit(/.claude/**)",
      "Edit(/opencode.json)",
      "Edit(/.opencode/**)",
      "Edit(/.githooks/**)",
      "Edit(/.github/**)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue delete *)",
      "Bash(gh api *)",
      "Bash(make permission-logs-prune*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *:*)",
      "Bash(git push *main*)",
      "Edit(/agent-kit/environments/local-sandbox/pre-push)",
      "Edit(/.devcontainer/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/agent-kit/claude-code/hooks/guard_git.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/agent-kit/claude-code/hooks/log_permission.py"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "AI assisted",
    "pr": "",
    "sessionUrl": false
  }
}
