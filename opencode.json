{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask",
      "agent-kit.conf": "ask",
      "_docs/specs.md": "ask",
      "agent-kit/*": "ask",
      "Makefile": "ask",
      ".claude/*": "ask",
      "opencode.json": "ask",
      ".opencode/*": "ask",
      ".githooks/*": "ask",
      ".github/*": "ask",
      ".devcontainer/*": "deny",
      "agent-kit/environments/local-sandbox/pre-push": "deny"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow",
      "git describe*": "allow",
      "git cat-file*": "allow",
      "git worktree list*": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git remote get-url *": "allow",
      "git fetch": "allow",
      "git fetch origin": "allow",
      "git branch --show-current": "allow",
      "git branch -vv": "allow",
      "git config --get *": "allow",
      "git commit *": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh label list*": "allow",
      "gh repo view*": "allow",
      "command -v *": "allow",
      "id": "allow",
      "pwd": "allow",
      "ls *": "allow",
      "date": "allow",
      "date -u": "allow",
      "realpath *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "sha256sum *": "allow",
      "*$*": "ask",
      "*`*": "ask",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*\n*": "ask",
      "* /*": "ask",
      "*../*": "ask",
      "* ..": "ask",
      "* ~*": "ask",
      "grep -r*": "ask",
      "grep -R*": "ask",
      "grep * -r*": "ask",
      "grep * -R*": "ask",
      "grep *--recursive*": "ask",
      "git commit *--amend*": "ask",
      "gh issue comment*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue reopen*": "ask",
      "gh issue delete*": "ask",
      "gh api*": "ask",
      "git remote add *": "deny",
      "git remote remove *": "deny",
      "git remote rename *": "deny",
      "git remote set-head *": "deny",
      "git remote set-branches *": "deny",
      "git remote set-url *": "deny",
      "git remote prune *": "deny",
      "git remote update *": "deny",
      "gh run view *--log*": "deny",
      "gh run view *--log-failed*": "deny",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add -u*": "deny",
      "git commit -n*": "deny",
      "git commit * -n*": "deny",
      "git commit -a*": "deny",
      "git commit * -a*": "deny",
      "git commit *--all*": "deny",
      "*--no-verify*": "deny",
      "*--output=*": "deny",
      "*--output *": "deny",
      "git push*": "deny",
      "git config core.hooksPath*": "deny",
      "gh auth token*": "deny",
      "gh auth status*--show-token*": "deny",
      "gh auth status*-t*": "deny",
      "gh auth git-credential*": "deny",
      "git credential*": "deny",
      "git config *credential*": "deny",
      "*.env*": "deny"
    }
  }
}
