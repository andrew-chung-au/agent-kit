{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git cat-file *)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git remote get-url *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(sha256sum *)"
    ],
    "ask": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/agent-kit.conf)",
      "Edit(/_docs/specs.md)",
      "Edit(/_docs/agent-kit/**)",
      "Edit(/.claude/**)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue delete *)",
      "Bash(gh api *)",
      "Bash(make permission-logs-prune*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote rename *)",
      "Bash(git remote set-head *)",
      "Bash(git remote set-branches *)",
      "Bash(git remote set-url *)",
      "Bash(git remote prune *)",
      "Bash(git remote update *)",
      "Bash(gh run view *--log*)",
      "Bash(gh run view *--log-failed*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/_docs/agent-kit/claude-code/hooks/guard_git.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/_docs/agent-kit/claude-code/hooks/log_permission.py"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "Generated with Claude Code",
    "pr": "",
    "sessionUrl": false
  }
}
