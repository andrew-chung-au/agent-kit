# agent-kit.conf: per-project settings for the agent kit's scripts and git hooks.
# Lives in the project folder (next to AGENTS.md). Its presence is what opts the
# folder in: the repo's git hooks only act on folders that contain this file.
#
# Patterns are matched against paths relative to this folder. "*" matches any
# characters, including "/", so "*.db" matches "data/app.db" too.

# Where the kit lives, relative to this folder.
KIT_DIR="_docs/agent-kit"

# The GitHub repository the kit's GitHub wrappers (the issue-* make targets and the sweep
# check) talk to, as "<owner>/<name>". They use `gh api` with
# this name, never the git remote, so they work where the remote is not github.com (Kiro
# Web). Read as text, never sourced; exactly one line; protected, so an agent cannot retarget.
# Without a valid value every wrapper refuses. Projects that don't use GitHub issues can omit it.
GITHUB_REPO="<owner>/<name>"

# The kit version this folder claims, checked by `make kit-check`: plain (1.9) for a
# pristine kit, <base>+<repo>.<n> (1.9+myrepo.2) once its files are changed here.
# KIT_VERSION=""

# Commands the verification gate runs. Leave TEST_CMD empty only before any
# code exists (verify then warns). Leave LINT_CMD / TYPECHECK_CMD empty until
# the project has them and the existing code passes (see blueprints.md).
TEST_CMD="make test"
LINT_CMD=""
TYPECHECK_CMD=""

# Test files: deleting these, or adding skip/focus markers to them, fails the gate.
TEST_FILES=( 'tests/*' '*test_*.py' '*_test.py' '*conftest.py' '*.test.*' '*.spec.*' 'e2e/*' )

# Never committed. Deleting an already-committed one is allowed.
FORBIDDEN=( '.env' '*/.env' '.env.*' '*/.env.*' '*.db' '*.sqlite' '*.sqlite3'
            '*__pycache__/*' '*.pyc' '*node_modules/*' '*.pem' '*.key' )
# Exceptions to FORBIDDEN.
ALLOWED=( '.env.example' '*/.env.example' )

# Light tier (process.md, Tiers): the paths a Light change may touch, checked by
# `make tier-check TIER=light`. Unset or empty means nothing qualifies. An entry on the
# check's fixed escalation list (scripts, hooks, tool settings, Makefile, this file,
# CI, test files, FORBIDDEN) is ignored. Example, Markdown docs only:
# LIGHT_ALLOWED=( 'README.md' 'docs/*.md' )
LIGHT_ALLOWED=()
# Most changed lines a Light change may have (default 20).
# LIGHT_MAX_LINES=20

# Commits touching these need HUMAN_APPROVED=1 (see the hook line in AGENTS.md).
PROTECTED=( 'AGENTS.md' 'CLAUDE.md' 'Makefile' 'agent-kit.conf' '_docs/specs.md' '_docs/agent-kit/*' )
