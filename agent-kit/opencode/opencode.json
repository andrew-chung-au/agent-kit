      "git commit * -n*": "deny",
      "git commit -a*": "deny",
      "git commit * -a*": "deny",
      "git commit *--all": "deny",
      "git commit *--all *": "deny",
      "git commit *--no-v*": "deny",
      "*--no-verify*": "deny",
      "*--output=*": "deny",
      "*--output *": "deny",
      "git push*": "deny",
      "git config core.hooksPath*": "deny",
      "gh auth token*": "deny",
      "gh auth status*--show-token*": "deny",
      "gh auth status*-t*": "deny",
      "gh auth git-credential*": "deny",
      "git credential*": "deny",
      "git config *credential*": "deny",
      "*.env*": "deny"
    }
  }
}
