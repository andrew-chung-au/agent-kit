      "gh issue comment*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue reopen*": "ask",
      "gh issue delete*": "ask",
      "gh api*": "ask",
