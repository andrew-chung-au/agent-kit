{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "AGENTS.md": "ask",
      "agent-kit.conf": "ask",
      "_docs/specs.md": "ask",
      "_docs/agent-kit/*": "ask",
      "opencode.json": "ask",
      ".opencode/*": "ask"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git cat-file*": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git remote get-url *": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "sha256sum*": "allow",
      "git remote add *": "deny",
      "git remote remove *": "deny",
      "git remote rename *": "deny",
      "git remote set-head *": "deny",
      "git remote set-branches *": "deny",
      "git remote set-url *": "deny",
      "git remote prune *": "deny",
      "git remote update *": "deny",
      "gh run view *--log*": "deny",
      "gh run view *--log-failed*": "deny",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add -u*": "deny",
      "git commit -a*": "deny",
      "git commit --all*": "deny",
      "*--no-verify*": "deny",
      "git push*": "deny",
      "git config core.hooksPath*": "deny"
    }
  }
}
