      "file *": "allow",
      "sha256sum *": "allow",
      "*$*": "ask",
      "*`*": "ask",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*\n*": "ask",
      "* /*": "ask",
      "*../*": "ask",
      "* ..": "ask",
      "* ~*": "ask",
      "grep -r*": "ask",
