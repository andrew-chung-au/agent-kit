{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "db"],
  "workspaceFolder": "/workspaces/<folder>",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.22.0",
      "nvmVersion": "0.40.8",
      "pnpmVersion": "none"
    }
  },
  "containerEnv": {
    "SSH_AUTH_SOCK": "",
    "GIT_TERMINAL_PROMPT": "0",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DATABASE_URL": "postgresql+psycopg://<db_user>:<db_password>@db:5432/<db_name>"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.opencode/bin",
    "OPENCODE_API_KEY": "${localEnv:OPENCODE_API_KEY}",
    "GH_TOKEN": "${localEnv:AGENT_GH_TOKEN}"
  },
  "mounts": ["source=claude-config,target=/home/vscode/.claude,type=volume"],
  "customizations": {
    "vscode": {
      "settings": {
        "github.gitAuthentication": false,
        "git.terminalAuthentication": false
      },
      "extensions": ["ms-python.python"]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
