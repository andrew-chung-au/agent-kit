#!/usr/bin/env bash
# agent-kit-hooks-version: 4
# Repo-wide pre-commit dispatcher, installed at <repo root>/.githooks by `make hooks`.
# For each folder touched by this commit that has adopted the agent kit (contains
# agent-kit.conf), runs that folder's own checks. Other folders are left alone.
# Also protects repo-root files that control how agents, checks and editors run:
# the hooks, CI workflows, the dev container recipe, VS Code workspace settings,
# .envrc and submodules. Agents must never bypass
# this with --no-verify.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

find_project() { # nearest ancestor folder of a path that contains agent-kit.conf
  local dir
  dir="$(dirname -- "$1")"
  while :; do
    if [ -f "$dir/agent-kit.conf" ]; then echo "$dir"; return; fi
    [ "$dir" = "." ] && return
    dir="$(dirname -- "$dir")"
  done
}

fail=0
# -z: NUL-delimited, so git never quotes an unusual name (a double quote or a
# backslash is quoted even with core.quotePath=false). Every path is the real one.
root_protected=()
projects=""
any=0
while IFS= read -r -d '' f; do
  any=1
  # Repo-root paths that need human approval in every repo using the kit.
  case "$f" in
    .githooks/*|.github/*|.devcontainer/*|.devcontainer.json|.vscode/*|.envrc|.gitmodules)
      root_protected+=("$f") ;;
  esac
  projects+="$(find_project "$f")"$'\n'
done < <(git diff --cached --name-only --no-renames -z)
[ "$any" -eq 0 ] && exit 0

if [ "${#root_protected[@]}" -gt 0 ] && [ "${HUMAN_APPROVED:-}" != "1" ]; then
  echo "agent-kit: this commit changes files that control hooks, CI, the dev container or your editor:" >&2
  printf '  %s\n' "${root_protected[@]}" >&2
  echo "  That needs human approval: HUMAN_APPROVED=1 git commit ..." >&2
  fail=1
fi

projects="$(printf '%s' "$projects" | sort -u)"
while IFS= read -r p; do
  [ -z "$p" ] && continue
  kit_dir="$( (cd "$p" && . ./agent-kit.conf && echo "${KIT_DIR:-_docs/agent-kit}") )"
  if [ ! -f "$p/$kit_dir/scripts/check-staged.sh" ]; then
    echo "agent-kit: $p has agent-kit.conf but no $kit_dir/scripts/check-staged.sh." >&2
    fail=1
    continue
  fi
  (cd "$p" && bash "$kit_dir/scripts/check-staged.sh") || fail=1
done <<< "$projects"

exit "$fail"
